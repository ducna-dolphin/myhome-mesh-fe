# mock (MSW) | remote. Unset: mock for `npm run dev`, remote for `npm run build`.
VITE_API_MODE=mock
VITE_API_BASE_URL=https://api.example.local
# Pending-spec tooltips; defaults to true in mock mode, false in remote mode.
# VITE_SHOW_SPEC_NOTES=true

# Browser bridge mock (only outside the Flutter host).
# Platform reported by the mock MyHome bridge: android | ios | web
VITE_MOCK_PLATFORM=android
# Android measurement function the mock host implements: SPEED (measureWifiSpeed) | RSSI (readWifiRssi) | NONE.
# Also sets `androidMethod` returned by the mocked GET /mesh/v1/signal-thresholds (NONE → SPEED).
VITE_MOCK_ANDROID_METHOD=SPEED

# MSW scenarios for the LLD API (VITE_API_MODE=mock).
# none | one | many
VITE_MOCK_CONTRACTS=one
# present | missing (contract without ONT serial)
VITE_MOCK_SERIAL=present
# empty | partial | full (5 locations: 1 WEAK, 2 FAIR, 2 GOOD)
VITE_MOCK_SURVEY=full
# Quality check result: stable | unstable (all 3 issues) | down (modem offline) | off (Wi-Fi off)
# | fail (weak Wi-Fi → order Mesh) | hogged (one device hogs bandwidth)
VITE_MOCK_HEALTH=stable
# online | offline (device reads/writes → 409 DEVICE_OFFLINE)
VITE_MOCK_DEVICE=online
